		"meta": {
			"author": "",
			"category": "effect",
			"deploymentTarget": {
				"branch": "",
				"name": "Wire",
				"version": {
					"major": 7,
					"minor": 27,
					"patch": 0
				}
			},
			"description": "Chronophotography (Muybridge \/ Marey): shows up to 8 past frames of the input as coloured echoes behind the live image. At rest (Echo Count 0) only the source is visible. Echo Count (0-8) and Frames between Echoes (1-4) set how many echoes and how far back; Echo Fade per Step and Echo Opacity control strength, Echo Color Near\/Far tint them, Offset X\/Y per Step spreads them like a motion study. Animate Echo Count or Echo Opacity on the music. Keeps 32 frames in GPU memory.",
			"displayName": "Chronophotography",
			"identifier": "9b869341-6b16-4446-8912-94141d409d90",
