		"meta": {
			"author": "Stefan Mazur",
			"category": "source",
			"deploymentTarget": {
				"branch": "",
				"name": "Wire",
				"version": {
					"major": 7,
					"minor": 29,
					"patch": 0
				}
			},
			"description": "Bulging Lines - horizontal lines across the whole frame bulge out where people stand in front of the surface. Driven by the Motion Bridge tool (2D lidar) over OSC; without the bridge the lines stay calm. Scale sizes everything relative to the output height. Lines: Line Count (lines per output height at Scale 1), Line Width, Line Color. Bulge: Bulge Height (how far the lines move at a person; negative bends them down), Bulge Width (half width of a bulge in output heights), Depth Influence (0 = every person bulges fully, 1 = only people at the surface bulge fully, far ones barely), Show People (a red marker per person, for setting up). Backdrop: Backdrop On, Backdrop Color (Off = transparent). OSC from the bridge: \/lidar\/x, \/lidar\/depth, \/lidar\/active (8 slots each), \/lidar\/alive. In Arena, enable OSC input in the Preferences and send the bridge to that port. Shader: Resource\/BulgingLines.fs.",
			"displayName": "Bulging Lines",
			"identifier": "18231369-8d7a-4444-b13d-7ec2fa10beec",
			"licenseName": "Unlicense",
			"mail": "S.Mazur@cati-co.de",
