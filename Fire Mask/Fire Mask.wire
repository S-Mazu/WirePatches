		"meta": {
			"author": "Stefan Mazur",
			"category": "effect",
			"deploymentTarget": {
				"branch": "",
				"name": "Wire",
				"version": {
					"major": 7,
					"minor": 23,
					"patch": 0
				}
			},
			"description": "Fire Mask - the brightness of the clip below decides what burns. A real-time fluid simulation. Burns as soon as it is loaded; Speed sets its tempo. Scale sizes everything relative to the output height. Physics: Speed, Rise (how strongly hot gas climbs; 0 lets smoke hang), Wind Direction and Wind Strength (carries all flames and smoke together), Swirl (the rolling eddies). Fire: Fire Amount (above 1 flames take over more and more of the frame, at 10 an inferno), Flame Length (how far flames reach before they burn out), Fire Burst (a short flare-up, good for FFT), Flame Core \/ Mid \/ Tip from hottest to coolest. Smoke: Smoke Amount (above 2 a fog builds over the whole frame), Smoke Life (seconds until it dissolves), Smoke Color. Burn: Burn Level picks the brightness that burns (0 = black, 1 = white), Burn Range is the width of the burning band around that brightness, Burn Softness its soft edge, Show Input keeps the clip visible under the fire. Shader: Resource\/FireMask.fs.",
			"displayName": "Fire Mask",
			"identifier": "b3845495-479d-45ad-809f-315931b93a3a",
			"licenseName": "",
			"mail": "S.Mazur@cati-co.de",
