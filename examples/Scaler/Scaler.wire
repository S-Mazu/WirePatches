			"45": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": true
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "1. CAMERA: copy these nodes into any patch.\nHeight becomes the reference: the visible area is y +-1\/Scale and x +-aspect\/Scale.\nzoom = clamp(1\/aspect, 1, 1000000) x clamp(Scale, 0.001, 1000)\nConnect Camera 2D to the camera input of every render node."
					}
				},
				"bounds": {
					"height": 130,
					"width": 1160,
					"x": 100,
					"y": -30
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "ffd0c117",
				"constants": {},
				"hidden": [
					"alignment",
					"fill",
					"font-size",
					"text"
				],
				"name": "How it works",
				"thumbnail_visible": true
			},
			"46": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": true
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "2. EDGES: where the frame is, in scene units.\nEdge Y = 1\/Scale, Edge X = aspect\/Scale.\nUse them to anchor elements to the frame."
					}
				},
				"bounds": {
					"height": 110,
					"width": 440,
					"x": 100,
					"y": 400
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "ffd0c117",
				"constants": {},
				"hidden": [
					"alignment",
					"fill",
					"font-size",
					"text"
				],
				"name": "Edges",
				"thumbnail_visible": true
			},
			"47": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": true
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "3. WHAT YOU SEE\nWhite circle: radius 1, touches top and bottom at Scale 1, on any surface.\nGray squares: one reference height each. A wider surface shows more of them, nothing is stretched.\nRed markers: anchored to the corners with Edge X and Edge Y.\nYellow line: anchored to the bottom edge with a fixed offset of 0.25 reference units."
					}
				},
				"bounds": {
					"height": 170,
					"width": 1160,
					"x": 100,
					"y": 1480
