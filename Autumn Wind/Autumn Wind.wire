				"constants": {},
				"hidden": [
					"alignment",
					"fill",
					"font-size",
					"text"
				],
				"name": "Slots, randoms, per-type tables",
				"thumbnail_visible": true
			},
			"201": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": true
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "State per slot via feedback: Drift (D) += velocity x dt x moving. Area is a torus with margin outside the frame, sized from the aspect ratio and Scale; Cell change = wrapped. Visible stays until wrapped; not allowed slots park at the entry edge and start at once when allowed. Rotation accumulates Tumble."
					}
				},
				"bounds": {
					"height": 1700,
					"width": 3500,
					"x": 2260,
